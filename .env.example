# =====================================================================
# WORDPILOT GRAMMAR CHECKING & MULTI-PROVIDER CONFIGURATION
# =====================================================================
# This environment file documents configuration options for WordPilot's
# API-only multi-provider grammar checking architecture with intelligent failover.
# DO NOT commit real API keys into version control.
# In the Android application, keys are securely stored using AES/GCM
# encryption backed by AndroidKeyStore.

APP_ENV=production

# 1. SAPLING AI — PRIMARY HOSTED PROVIDER
# Sign up at https://sapling.ai to obtain an API key
SAPLING_ENABLED=true
SAPLING_API_KEY=
SAPLING_TIMEOUT_SECONDS=10
SAPLING_VARIETY=us-variety
SAPLING_MAX_REQUEST_CHARS=4000

# 2. LANGUAGETOOL — FIRST FALLBACK PROVIDER
# Point to your self-hosted Docker / server instance or authorized commercial endpoint
# (e.g. http://192.168.1.100:8081 or https://languagetool.yourdomain.com)
# NEVER point to unauthenticated public endpoints without authorization
LANGUAGETOOL_ENABLED=false
LANGUAGETOOL_BASE_URL=
LANGUAGETOOL_TIMEOUT_SECONDS=10

# 3. GRAMMARBOT NEURAL — SECOND FALLBACK PROVIDER
# Sign up on RapidAPI for GrammarBot Neural API
# Keep disabled until credentials and subscription limits are verified
GRAMMARBOT_ENABLED=false
GRAMMARBOT_API_KEY=
GRAMMARBOT_HOST=grammarbot-neural.p.rapidapi.com
GRAMMARBOT_TIMEOUT_SECONDS=10

# SEQUENTIAL FAILOVER PRIORITY (comma-separated, in execution order)
GRAMMAR_PROVIDER_PRIORITY=sapling,languagetool,grammarbot

# RELIABILITY & CIRCUIT BREAKER SETTINGS
GRAMMAR_MAX_RETRIES=1
GRAMMAR_CIRCUIT_FAILURE_THRESHOLD=3
GRAMMAR_CIRCUIT_COOLDOWN_SECONDS=60
GRAMMAR_REQUEST_TIMEOUT_SECONDS=15
